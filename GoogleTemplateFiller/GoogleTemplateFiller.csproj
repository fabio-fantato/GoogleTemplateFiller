<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>GoogleTemplateFiller</AssemblyName>
        <RootNamespace>GoogleTemplateFiller</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="Logo.png" />
        <EmbeddedResource Include="Logo.png" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="OutSystems.ExternalLibraries.SDK" Version="1.5.0" />
        <PackageReference Include="Google.Apis.Docs.v1" Version="1.69.0.3701" />
        <PackageReference Include="Google.Apis.Drive.v3" Version="1.69.0.3674" />
        <PackageReference Include="Google.Apis.Auth" Version="1.69.0" />
    </ItemGroup>
</Project>
